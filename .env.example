# ============================================================
# REQUIRED — Pipeline will not start without these
# ============================================================

# Binary Paths (must be executable and match container architecture)
# Note: These binaries are currently in beta. Contact your HashiCorp representative to obtain them.
# Example for macOS ARM64: /opt/homebrew/bin/terraform
# Example for Linux AMD64: /usr/local/bin/terraform
TERRAFORM_BINARY_PATH=/path/to/terraform
TFPOLICY_BINARY_PATH=/path/to/tfpolicy

# Authentication Provider (choose one: litellm or github-copilot)
AUTH_PROVIDER=litellm

# --- For LiteLLM (default) ---
MODEL_BASE_URL=https://your-litellm-endpoint.com
MODEL_API_KEY=sk-your-litellm-api-key
MODEL_NAME=aws/claude-sonnet-4-5

# --- For GitHub Copilot (alternative) ---
# AUTH_PROVIDER=github-copilot
# MODEL_NAME=claude-sonnet-4.6
# GITHUB_COPILOT_ACCESS_TOKEN=gho_your_access_token
# GITHUB_COPILOT_REFRESH_TOKEN=gho_your_refresh_token  # Optional, defaults to access token
# GITHUB_COPILOT_EXPIRES=0  # Optional, defaults to 0
#
# Supported models: claude-sonnet-4.6, gpt-5.2
# Note: claude-sonnet-4.5 is NOT supported by GitHub Copilot (verified as of June 2026)
# Find your tokens in: ~/.local/share/opencode/auth.json

# ============================================================
# COMMON — Change these for each project or run
# ============================================================

# Data directory (mounted to container's /workspace/data)
# Relative paths are resolved from current working directory
DATA_DIR=./data

# Input/Output subdirectories within DATA_DIR
INPUT_DIR=input
OUTPUT_DIR=output

# Input file for policy extraction (relative to DATA_DIR/INPUT_DIR/)
INPUT_FILE=policy_goal.txt

# External repository path (required for run_with_external_repo.sh)
# Path to your Sentinel policy repository
EXTERNAL_REPO_DIR=./workdir/workspaces/external_repo

# Path to sentinel.hcl file (optional, for enforcement level configuration)
# SENTINEL_HCL_PATH=

# Maximum parallel workers for pipeline execution
MAX_WORKERS=5

# ============================================================
# ADVANCED — Defaults work for most cases
# ============================================================

# Docker Configuration
IMAGE_NAME=icr.io/polaris-20251120/terraform-pac-agent
IMAGE_TAG=0.0.24
CONTAINER_PREFIX=terraform-pac-agent-skills

# Timeout Configuration (in seconds)
STAGE0_TIMEOUT=600              # Policy Extraction (10 minutes)
STAGE1_TIMEOUT=300              # Requirement Generation per goal (5 minutes)
STAGE2_TIMEOUT=900              # Policy Generation per policy (15 minutes)
STAGE3_TIMEOUT_BASE=180         # Summary Generation base (3 minutes)
STAGE3_TIMEOUT_PER_POLICY=60    # Summary Generation per policy (1 minute)
STAGE4_TIMEOUT=300              # Validation Fixtures per policy (5 minutes)

# Retry Configuration
MAX_RETRIES=1                   # Number of retries for failed tasks (timeout increases by 1.5x per retry)

# Stage 4: Validation Fixtures Generation (Optional)
ENABLE_STAGE4=false             # Set to true to enable validation fixtures generation

# MCP Server Configuration (pre-configured in Dockerfile, no need to change)
POLICY_DB=database/policy_spec_db.jsonl
POLICY_SUMMARY=database/POLICY_SUMMARY.md

# Feature Flags
# ENABLE_SENTINEL_MOCK_USE=true  # Use mock files from test/ directories (default: true)

# ============================================================
# NOTES
# ============================================================
# 
# OUTPUT_DIR behavior:
# - For run.sh: Must be empty for new runs to prevent accidental overwrites
# - For run_with_external_repo.sh: Automatically timestamped (e.g., output-20260603_012345)
#   and this setting is ignored to prevent conflicts
#
# Container names:
# - Use CONTAINER_PREFIX to run multiple environments (dev/staging/prod)
# - Example: CONTAINER_PREFIX=dev-pac for development environment
#
# Timeout strategy:
# - Initial attempt uses configured timeout
# - Each retry increases timeout by 1.5x
# - Example: 300s → 450s → 675s (for MAX_RETRIES=2)
